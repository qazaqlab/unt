<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#0a0e1a">

    <TextView
        android:id="@+id/tv_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UNT 140 ACADEMY • ҚАТАҢ ФОКУС РЕЖИМІ"
        android:textColor="#f87171"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="#1f1118" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="САБАҚ АЯҚТАЛҒАН ЖОҚ!"
        android:textColor="#f8fafc"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Сабақ немесе Помодоро уақыты аяқталғанға дейін әлеуметтік желілер мен ойындар бұғатталған. Фокусты жоғалтпай, мақсатыңызға жетіңіз!"
        android:textColor="#94a3b8"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:background="#111827"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_blocked_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Бұғатталған әрекет: Әлеуметтік желі / Ойын"
            android:textColor="#fbbf24"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_current_lesson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Ағымдағы сабақ: ҰБТ ФизМат 140 күндік бағдарламасы"
            android:textColor="#38bdf8"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_return_study"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="32dp"
        android:text="САБАҚҚА ОРАЛУ"
        android:textColor="#ffffff"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#2563eb" />

    <Button
        android:id="@+id/btn_emergency_unlock"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:text="Шұғыл жағдайда сабақты аяқтау"
        android:textColor="#64748b"
        android:textSize="12sp"
        android:backgroundTint="#00000000" />

</LinearLayout>
